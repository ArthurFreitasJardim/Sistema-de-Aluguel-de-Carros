@startuml
title Diagrama de Implantação - Sistema Completo de Aluguel de Carros

skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName Arial
skinparam node {
    BackgroundColor #E8F0FE
    BorderColor #1E3A8A
}
skinparam database {
    BackgroundColor #FEF3C7
    BorderColor #D97706
}
skinparam cloud {
    BackgroundColor #DCFCE7
    BorderColor #16A34A
}

node "💻 Cliente\nNavegador Web" as Cliente {
    artifact "Portal do Cliente\nCadastro, Pedidos,\nConsulta, Cancelamento"
}

node "🏢 Empresa Agente\nPortal Administrativo" as Empresa {
    artifact "Avaliação de Pedido"
    artifact "Gestão de Contratos"
    artifact "Gestão de Veículos"
}

node "🏦 Banco Agente\nPortal Financeiro" as Banco {
    artifact "Análise Financeira"
    artifact "Crédito"
    artifact "Aprovação / Reprovação"
}

node "🌐 Servidor de Aplicação\nMicronaut + MVC + Hibernate" as App {
    artifact "Módulo Cadastro"
    artifact "Módulo Pedidos"
    artifact "Módulo Contratos"
    artifact "Módulo Crédito"
    artifact "Módulo Veículos"
    artifact "Autenticação"
}

database "🗄️ Banco de Dados Central\nH2 / PostgreSQL" as DB {
    artifact "Clientes"
    artifact "Empresas"
    artifact "Bancos"
    artifact "Pedidos"
    artifact "Contratos"
    artifact "Crédito"
    artifact "Veículos"
}

cloud "🚗 API FIPE" as FIPE {
    artifact "Marcas"
    artifact "Modelos"
}

Cliente --> App : HTTP/HTTPS\nPedidos e Consultas
Empresa --> App : HTTP/HTTPS\nAvaliação e Gestão
Banco --> App : HTTP/HTTPS\nAnálise Financeira
App --> DB : JDBC / Hibernate ORM
Cliente --> FIPE : Fetch API\nMarcas e Modelos
Empresa --> FIPE : Consulta de Veículos

@enduml
